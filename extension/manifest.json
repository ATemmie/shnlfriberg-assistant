{
  "manifest_version": 3,
  "name": "Shnlfriberg Helper",
  "version": "3.0",
  "description": "CS2 guess game assistant for shnlfriberg.online — fully client-side, no server needed.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://shnlfriberg.online/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://shnlfriberg.online/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["players.json"],
      "matches": ["https://shnlfriberg.online/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shnlfriberg Helper",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
